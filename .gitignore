# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# Next.js & Build Outputs
/.next/
/out/
/build
/dist

# Cache & Turbopack
.turbo
.cache

# Supabase (CLI local state & temporary branches)
supabase/.temp/
supabase/.branches/
.supabase

# Environment variables (ignore secrets, keep example templates tracked)
.env*
!.env.example
!.env*.example

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Testing & Coverage
/coverage
*.lcov
.nyc_output
test-results/
playwright-report/
blob-report/

# Logs & Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
bun.report*
*.log

# Vercel
.vercel

# IDE & Editors
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.fleet/

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini

# Security, Certificates & Temporary Files
*.pem
*.key
*.cert
*.tmp
*.temp
